# --- LLM (OpenAI-compatible). Optional: without a key Yaris runs a deterministic
# --- demo generator so the whole pipeline works offline.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- HDX HAPI (deep-dive structured data). Optional: falls back to bundled
# --- demo datasets when unset or unreachable.
# app_identifier is base64("app_name:email"). Provide it directly, or provide
# the two parts and Yaris will encode them for you.
HAPI_BASE_URL=https://hapi.humdata.org
HAPI_APP_IDENTIFIER=
HAPI_APP_NAME=yaris
HAPI_APP_EMAIL=

# --- Set to 1 to force offline mode (skip HAPI network calls)
YARIS_OFFLINE=0
